{
    "$schema": "https://oxc.rs/schema/oxlintrc.json",
    "plugins": ["typescript"],
    "rules": {
        "no-console": "warn",
        "eqeqeq": "error",
        "no-debugger": "error"
    },
    "overrides": [
        {
            "files": ["src/library/Logging.ts"],
            "rules": { "no-console": "off" }
        }
    ]
}
