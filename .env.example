# Plantilla de variables de entorno.
# Cópiala con el nombre .env (cp .env.example .env). Tu .env no se sube a GitHub.

# Dirección de tu base de datos MongoDB.
# Con MongoDB instalado en tu ordenador, déjala tal cual.
# Con MongoDB Atlas, pega aquí la dirección que te da Atlas (empieza por mongodb+srv://).
MONGO_URL=mongodb://127.0.0.1:27017/seminari5

# Puerto de la API. Con 1337, la API responde en http://localhost:1337
SERVER_PORT=1337

# Origen del cliente Angular. Debe ser exacto cuando la API usa cookies/credenciales.
CORS_ORIGIN=http://localhost:4200

# Secretos con los que se firman los tokens JWT: uno para el access token y otro para el refresh token.
# Tienen que ser distintos. Estos valores sirven para clase; en un servidor real se usa un texto
# largo y aleatorio, por ejemplo el que da: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=seminari7-access-secret-cambiame
JWT_REFRESH_SECRET=seminari7-refresh-secret-cambiame

# Cuánto dura cada token: 15m son 15 minutos, 7d son 7 días.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
